{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "types": ["node"],
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true
  },
  // The seed and the other Prisma-side scripts. They are outside `src`, so the
  // application typecheck never sees them: a ReferenceError there once shipped
  // green through typecheck, lint, build and CI's verify step.
  "include": ["prisma/**/*.ts", "*.ts"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts"]
}
