{
  "name": "@matrimony/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\" \"src/**/*.tsx\"",
    "test": "jest --passWithNoTests --json --outputFile=.jest-results.json",
    "build:android": "eas build --platform android --profile preview",
    "build:ios": "eas build --platform ios --profile preview"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@matrimony/shared": "*",
    "expo": "^57.0.0",
    "expo-constants": "~57.0.25",
    "expo-document-picker": "~57.0.3",
    "expo-image-picker": "~57.0.22",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.14",
    "expo-notifications": "~57.0.26",
    "expo-router": "~57.0.32",
    "expo-secure-store": "~57.0.4",
    "jest-expo": "~57.0.6",
    "query-string": "^7.1.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@react-native/jest-preset": "^0.86.3",
    "@types/react": "~19.2.4",
    "eas-cli": "^27.4.0",
    "typescript": "~6.0.3"
  }
}
