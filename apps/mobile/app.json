{
  "expo": {
    "owner": "alphaclark",
    "name": "Networth Matrimony",
    "slug": "networth-matrimony",
    "scheme": "networth-matrimony",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Networth Matrimony uses your photos to add profile pictures."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.networth.matrimony"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.networth.matrimony",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "apiBaseUrl": "https://matrimony-api-2bmy.onrender.com/api/v1",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "87fd77dc-6c58-4ec6-a52f-33264243c245"
      }
    }
  }
}
