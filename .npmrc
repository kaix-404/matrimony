# The mobile workspace pins react-native@0.76.x, whose peer range wants
# @types/react@^18, while the API/Admin workspaces use react@19 (which pulls
# @types/react@19). npm 7+ treats that as a hard ERESOLVE failure and aborts
# the install, which is what broke every Render build.
# Resolving it here rather than with a --legacy-peer-deps flag on each command
# means Render's automatic install step, `npm ci` in GitHub Actions, and the
# Docker build all agree without anyone having to remember the flag.
legacy-peer-deps=true

# Exclude Expo/React Native packages from root node_modules hoisting so the
# mobile app's own declarations are the only visible copies. Gradle tries to
# evaluate Gradle projects from any Expo-related folder in node_modules; keeping
# expo-dev-menu expo-dev-menu-interface expo-router etc. only under
# apps/mobile prevents that evaluation from running outside the intended app.
# This line prevents npm from hoisting expo packages to the root so only the
# mobile app's own copies appear (and they have no Gradle projects).
hoist-limit=0