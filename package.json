{
  "name": "matrimony",
  "version": "0.1.0",
  "private": true,
  "description": "Matrimony platform — React Native app, NestJS API, Next.js admin dashboard",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.6.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run build -w @matrimony/shared && npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "prisma:generate": "npm run prisma:generate -w @matrimony/api",
    "prisma:validate": "npm run prisma:validate -w @matrimony/api",
    "prisma:migrate": "npm run prisma:migrate -w @matrimony/api",
    "prisma:deploy": "npm run prisma:deploy -w @matrimony/api",
    "prisma:seed": "npm run prisma:seed -w @matrimony/api",
    "prisma:studio": "npm run prisma:studio -w @matrimony/api",
    "dev": "docker compose -f infra/docker/docker-compose.yml up -d",
    "dev:storage": "docker compose -f infra/docker/docker-compose.yml --profile storage up -d",
    "dev:down": "docker compose -f infra/docker/docker-compose.yml down",
    "dev:logs": "docker compose -f infra/docker/docker-compose.yml logs -f",
    "setup": "npm install && npm run prisma:generate && npm run prisma:migrate && npm run prisma:seed",
    "verify": "npm run prisma:validate && npm run prisma:generate && npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "metro": "^0.81.5",
    "react-native": "0.76.3",
    "react-native-web": "0.19.13",
    "react-native-safe-area-context": "5.11.0",
    "react-native-screens": "4.0.0",
    "react-native-gesture-handler": "2.20.0",
    "react-native-reanimated": "3.16.0",
    "expo-router": "4.0.22",
    "query-string": "^9.0.0",
    "expo-linking": "^7.0.5",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "react-helmet-async": "^2.0.0",
    "react-native-helmet-async": "^2.0.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@neon/config": "^1.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "@neon/env": "^1.6.8",
    "@nestjs/cli": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.12"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
