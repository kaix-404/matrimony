# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit a populated .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
TZ=UTC

# --- API --------------------------------------------------------------------
API_PORT=4000
API_GLOBAL_PREFIX=api/v1
API_CORS_ORIGINS=http://localhost:3000

# Secrets MUST come from a secret manager in staging/production.
# Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Database ---------------------------------------------------------------
POSTGRES_USER=matrimony
POSTGRES_PASSWORD=matrimony_dev_password
POSTGRES_DB=matrimony
# 5433 on the host, not 5432. A locally installed PostgreSQL commonly owns
# 5432, and when it does, host connections silently reach that server instead
# of the container and fail with "authentication failed" for credentials that
# are in fact correct. Keeping the container off 5432 avoids the collision.
POSTGRES_PORT=5433
DATABASE_URL=postgresql://matrimony:matrimony_dev_password@localhost:5433/matrimony?schema=public

# --- Redis (cache, rate limiting, queues) -----------------------------------
REDIS_URL=redis://localhost:6379

# --- Object storage (S3-compatible; Cloudflare R2 in production) -------------
# R2 is S3-API compatible, so the same client code serves both. The region is
# "auto": R2 is a single global service addressed by account, not by region.
# Locally this points at MinIO instead, which is why FORCE_PATH_STYLE exists.
#
# RESIDENCY WARNING (docs/decisions/client-provider-decisions-2026-10-01.md,
# GAP-11): the client chose Cloudflare R2, but R2 has NO India jurisdiction. Its
# hard-residency controls are only eu/us/fedramp; "apac" is a best-effort location
# hint, not a guarantee. Answer H3 committed the platform to India-only storage, so
# this conflicts with it. Until the client accepts the weaker position or picks an
# alternative, DO NOT treat these photos as India-resident.
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=networth-matrimony-profiles
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
# Presigned URL TTL in seconds. Keep short: photos must not be scrapeable.
S3_SIGNED_URL_TTL=300

# --- Payments (Razorpay) ----------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Identity verification (Cashfree Secure ID) -----------------------------
# D9 makes Aadhaar/DigiLocker verification mandatory. Cashfree is the chosen
# provider; use its DigiLocker flow, which returns an already-masked number and
# retains no document. A RAW AADHAAR NUMBER IS NEVER STORED by us.
# Cashfree is also a payment gateway; Razorpay is our payment gateway, so the two
# accounts are separate and neither is used for the other's job.
CASHFREE_ENVIRONMENT=sandbox
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=

# --- Notifications ----------------------------------------------------------
# Firebase was confirmed on 2026-10-01. Use the HTTP v1 API, not the legacy
# server key, which is deprecated. FCM payloads pass through Google's
# infrastructure, so notification content must carry no sensitive profile data.
FCM_SERVICE_ACCOUNT_JSON=
# SMS and email providers are still open; the client is looking for something
# cheaper than MSG91, with MSG91 as the fallback. Config stays provider-agnostic
# until that settles. DLT registration is required for transactional SMS in India
# regardless of which provider is chosen, and is the client's to do.
SMS_PROVIDER_API_KEY=
SMS_SENDER_ID=
SMS_DLT_ENTITY_ID=
SMS_DLT_TEMPLATE_ID=
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_TTL_SECONDS=300

# --- Domain rules (client schedule confirmed 2026-09-29) -------------------
# The four net-worth bands and their unlock prices. The authoritative values
# live in the database (net_worth_category_ref + pricing_config); these
# variables are only the bootstrap defaults the seed writes.
#   BELOW_2CR        below Rs 2 Cr     Rs  99.00 + 18% GST = Rs  116.82
#   TWO_CR_TO_FIVE_CR Rs 2-5 Cr        Rs 249.00 + 18% GST = Rs  293.82
#   FIVE_CR_TO_TEN_CR Rs 5-10 Cr       Rs 499.00 + 18% GST = Rs  588.82
#   ABOVE_10CR       above Rs 10 Cr    Rs 999.00 + 18% GST = Rs 1178.82
# Further bands are added as rows, not as code: see docs/decisions.
PRICING_BELOW_2CR_BASE=99.00
PRICING_TWO_CR_TO_FIVE_CR_BASE=249.00
PRICING_FIVE_CR_TO_TEN_CR_BASE=499.00
PRICING_ABOVE_10CR_BASE=999.00
PRICING_GST_RATE=0.18
# D9: one-time account setup fee, charged at the last registration step.
# Treated as a flat total with no separate GST (see docs/decisions GAP-5).
ACCOUNT_SETUP_FEE=15.00
# C3: reminder lead time before an unlock expires, in hours.
UNLOCK_EXPIRY_REMINDER_HOURS=2
# F6: retention before a deleted account is irreversibly erased, in months.
DELETED_ACCOUNT_RETENTION_MONTHS=6
# Section 15: unlock window in hours. Server time only.
UNLOCK_WINDOW_HOURS=24
