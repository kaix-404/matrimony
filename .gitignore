# dependencies
node_modules/
.pnp
.pnp.js

# build output
dist/
build/
.next/
out/
*.tsbuildinfo

# environment / secrets  (NEVER commit these)
.env
.env.*
!.env.example
*.pem
*.key

# Service-account key files. A Firebase Admin SDK download is a *private key*:
# it grants full admin access to the Firebase project and can mint tokens for any
# user in it. It arrives by browser download and is easy to drop into a docs
# folder by habit, which is exactly how it ends up in a commit. Matched by name so
# the rule survives a rename of the surrounding directory.
*firebase-adminsdk*.json
*service-account*.json
serviceAccount*.json
# Provider key files, in case a client hands them over the same way.
*credentials*.json

# test + coverage
coverage/
.nyc_output/

# logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# editors
.idea/
.vscode/*
!.vscode/*.example
*.swp

# OS
.DS_Store
Thumbs.db
desktop.ini

# local databases / volumes
infra/docker/data/
*.sqlite
*.sqlite3
*.db

# generated prisma client (output of `prisma generate`)
apps/api/src/generated/
packages/*/src/generated/
